---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Contact from '../../components/Contact.astro';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, summary, tag, date } = article.data;
const published = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base title={`${title} · ${profile.name}`} description={summary}>
  <Header showArticles base="/" />
  <main class="section">
    <article class="article">
      <a href="/#articles" class="back">← All articles</a>
      <p class="meta muted">
        <span class="tag">{tag}</span> · <time datetime={date.toISOString().slice(0, 10)}>{published}</time>
      </p>
      <h1>{title}</h1>
      <p class="summary muted">{summary}</p>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
  <Contact />
</Base>

<style>
  .article {
    max-width: 720px;
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-bottom: 32px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .meta {
    margin: 0 0 12px;
    font-size: 14px;
  }

  .tag {
    font-weight: 600;
    color: var(--accent);
  }

  h1 {
    margin: 0 0 16px;
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .summary {
    margin: 0 0 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
    font-size: 20px;
    line-height: 1.5;
  }

  .prose {
    font-size: 17px;
    line-height: 1.7;
  }

  .prose :global(h2) {
    margin: 48px 0 12px;
    font-size: 28px;
    line-height: 1.25;
  }

  .prose :global(h3) {
    margin: 32px 0 8px;
    font-size: 21px;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 20px;
  }

  .prose :global(li + li) {
    margin-top: 6px;
  }

  .prose :global(blockquote) {
    margin: 28px 0;
    padding: 4px 0 4px 20px;
    border-left: 3px solid var(--accent);
    font-size: 19px;
    color: var(--muted);
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  .prose :global(code) {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.88em;
  }

  .prose :global(:not(pre) > code) {
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--band);
    border: 1px solid var(--line);
  }

  .prose :global(pre) {
    margin: 0 0 24px;
    padding: 20px;
    border-radius: 12px;
    border: 1px solid var(--line);
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.6;
  }

  .prose :global(table) {
    display: block;
    width: 100%;
    margin: 0 0 24px;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 15px;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    white-space: nowrap;
  }

  .prose :global(th) {
    font-weight: 600;
  }
</style>
