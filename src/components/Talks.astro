---
import ShowMore from './ShowMore.astro';
import { getTalkOffers, getPastTalks, getUpcomingTalks } from '../data/talks';
import { profile } from '../data/profile';

const VISIBLE = 5;
const offers = (await getTalkOffers()).map((o) => o.data);
const pastTalks = await getPastTalks();
const [next, ...later] = (await getUpcomingTalks()).map((t) => t.data);

const longDate = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const shortDate = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const place = (t: { event: string; city?: string }) => (t.city ? `${t.event} · ${t.city}` : t.event);
---

<section id="talks" class="section band">
  <div class="container">
    <h2 class="section-title tight">Talks I offer</h2>
    <p class="intro muted">
      Sessions ready for your conference or meetup. Full abstracts on <a href={profile.sessionize}>Sessionize</a>.
    </p>
    <div class="offers">
      {
        offers.map((o) => (
          <article class="card offer">
            <span class="tag">{o.tag}</span>
            <h3>{o.title}</h3>
            <p class="muted">{o.blurb}</p>
          </article>
        ))
      }
    </div>

    {
      next && (
        <>
          <h3 class="list-title">Upcoming talks</h3>
          <article class="next">
            <div class="next-text">
              <p class="next-when">
                Next up · <time datetime={next.date.toISOString().slice(0, 10)}>{longDate(next.date)}</time>
              </p>
              <h4>{next.title}</h4>
              <p class="next-where">{place(next)}</p>
            </div>
            {next.url && (
              <a class="button button--primary" href={next.url}>
                Event page
              </a>
            )}
          </article>
          {later.length > 0 && (
            <ul class="past upcoming">
              {later.map((t) => (
                <li>
                  <time class="date" datetime={t.date.toISOString().slice(0, 10)}>
                    {shortDate(t.date)}
                  </time>
                  <span class="title">{t.title}</span>
                  <span class="event muted">{place(t)}</span>
                  {t.url && (
                    <span class="links">
                      <a href={t.url}>Event page</a>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          )}
        </>
      )
    }

    <h3 class="list-title">Past talks</h3>
    <ul id="past-talks" class="past" data-collapsible>
      {
        pastTalks.map((t, i) => (
          <li data-extra={i >= VISIBLE ? '' : undefined}>
            <span class="year muted">{t.year}</span>
            <span class="title">{t.title}</span>
            <span class="event muted">{t.event}</span>
            {(t.slides || t.video) && (
              <span class="links">
                {t.slides && <a href={t.slides}>Slides</a>}
                {t.video && <a href={t.video}>Video</a>}
              </span>
            )}
          </li>
        ))
      }
    </ul>
    {pastTalks.length > VISIBLE && <ShowMore target="past-talks" moreLabel={`Show all ${pastTalks.length} past talks`} />}
  </div>
</section>

<style>
  .tight {
    margin-bottom: 8px;
  }

  .intro {
    margin: 0 0 32px;
    font-size: 17px;
  }

  .offers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .offer {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tag {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
  }

  .offer h3 {
    margin: 0;
    font-size: 20px;
    line-height: 1.3;
  }

  .offer p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }

  .list-title {
    margin: 56px 0 16px;
    font-size: 22px;
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 32px;
    padding: 28px 32px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--feature);
    color: #f1f5f9;
  }

  .next-text {
    flex: 1 1 480px;
    min-width: 0;
  }

  .next-when {
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #93c5fd;
  }

  .next h4 {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.25;
  }

  .next-where {
    margin: 0;
    color: #cbd5e1;
  }

  .upcoming {
    margin-top: 8px;
  }

  .upcoming li:first-child {
    border-top: none;
  }

  .date {
    width: 110px;
    font-weight: 600;
    color: var(--link);
  }

  .past {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .past li {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }

  .year {
    width: 56px;
    font-weight: 600;
  }

  .title {
    flex: 1 1 320px;
    font-weight: 500;
  }

  .links {
    display: flex;
    gap: 12px;
  }
</style>
