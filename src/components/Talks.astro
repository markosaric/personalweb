---
import ShowMore from './ShowMore.astro';
import { offers, pastTalks } from '../data/talks';
import { profile } from '../data/profile';

const VISIBLE = 5;
---

<section id="talks" class="section band">
  <div class="container">
    <h2 class="section-title tight">Talks I offer</h2>
    <p class="intro muted">
      Sessions ready for your conference or meetup. Full abstracts on <a href={profile.sessionize}>Sessionize</a>.
    </p>
    <div class="offers">
      {
        offers.map((o) => (
          <article class="card offer">
            <span class="tag">{o.tag}</span>
            <h3>{o.title}</h3>
            <p class="muted">{o.blurb}</p>
          </article>
        ))
      }
    </div>

    <h3 class="past-title">Past talks</h3>
    <ul id="past-talks" class="past" data-collapsible>
      {
        pastTalks.map((t, i) => (
          <li data-extra={i >= VISIBLE ? '' : undefined}>
            <span class="year muted">{t.year}</span>
            <span class="title">{t.title}</span>
            <span class="event muted">{t.event}</span>
            {(t.slides || t.video) && (
              <span class="links">
                {t.slides && <a href={t.slides}>Slides</a>}
                {t.video && <a href={t.video}>Video</a>}
              </span>
            )}
          </li>
        ))
      }
    </ul>
    {pastTalks.length > VISIBLE && <ShowMore target="past-talks" moreLabel={`Show all ${pastTalks.length} past talks`} />}
  </div>
</section>

<style>
  .tight {
    margin-bottom: 8px;
  }

  .intro {
    margin: 0 0 32px;
    font-size: 17px;
  }

  .offers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .offer {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tag {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
  }

  .offer h3 {
    margin: 0;
    font-size: 20px;
    line-height: 1.3;
  }

  .offer p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
  }

  .past-title {
    margin: 56px 0 16px;
    font-size: 22px;
  }

  .past {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .past li {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }

  .year {
    width: 56px;
    font-weight: 600;
  }

  .title {
    flex: 1 1 320px;
    font-weight: 500;
  }

  .links {
    display: flex;
    gap: 12px;
  }
</style>
