---
import { Image } from 'astro:assets';
import ShowMore from './ShowMore.astro';
import { certifications } from '../data/certifications';
import { profile } from '../data/profile';

const VISIBLE = 5;
---

<section id="certs" class="section band">
  <div class="container">
    <h2 class="section-title">Certifications</h2>
    <ul id="cert-list" class="certs" data-collapsible>
      {
        certifications.map((c, i) => (
          <li class="card cert" data-extra={i >= VISIBLE ? '' : undefined}>
            {c.kind === 'badge' ? (
              <>
                <Image src={c.image} alt={`${c.name} badge`} width={96} height={96} densities={[1, 2]} class="badge" />
                <span class="name">{c.name}</span>
                {c.issuer && <span class="issuer muted">{c.issuer}</span>}
              </>
            ) : (
              <Image src={c.image} alt={`Microsoft ${c.abbr ?? ''} ${c.name} logo`.replace(/\s+/g, ' ')} height={128} densities={[1, 2]} class="logo logo-invert" />
            )}
          </li>
        ))
      }
    </ul>
    {certifications.length > VISIBLE && <ShowMore target="cert-list" moreLabel={`Show all ${certifications.length} certifications`} />}
    <p class="verify"><a href={profile.learnTranscript}>Verify on Microsoft Learn</a></p>
  </div>
</section>

<style>
  .certs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .cert {
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
  }

  .badge {
    width: 96px;
    height: 96px;
    object-fit: contain;
    display: block;
  }

  .logo {
    width: 100%;
    max-width: 220px;
    height: 128px;
    object-fit: contain;
    display: block;
  }

  .name {
    font-weight: 600;
    line-height: 1.3;
  }

  .issuer {
    font-size: 14px;
  }

  .verify {
    margin: 20px 0 0;
    font-size: 15px;
  }
</style>
