---
import { socials } from '../data/profile';
---

<footer id="contact" class="contact">
  <div class="container inner">
    <div>
      <h2>Planning an event?</h2>
      <p class="muted">Write to me and I will reply within a few days.</p>
    </div>
    <ul class="socials">
      {
        socials.map((s) => (
          <li>
            <a href={s.url} class="button social" rel="me">
              {s.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .contact {
    border-top: 1px solid var(--line);
    padding: 64px 24px;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    justify-content: space-between;
    align-items: center;
  }

  h2 {
    margin: 0 0 8px;
    font-size: 32px;
  }

  p {
    margin: 0;
  }

  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .social {
    padding: 12px 18px;
    font-weight: 500;
  }
</style>
